# === frontend/.env.example ===
# Copy to frontend/.env.local and adjust if the local API uses another port.
# Development browser requests remain same-origin through Vite's /api proxy.

VITE_API_PROXY_TARGET=http://localhost:8000

# CARTO Basemaps API key for the climate-area map tiles. Request one (free,
# commercial tier up to 1M requests/month) at https://carto.com/basemaps/apikey.
# The key is a public, referrer-restricted browser credential — restrict it to
# the app domain(s) on the CARTO dashboard. Without it the maps fall back to
# the keyless OSM standard style.
# VITE_CARTO_BASEMAP_KEY=

# Production builds may set VITE_API_BASE_URL to a separate API origin.
# VITE_API_BASE_URL=https://api.example.com
